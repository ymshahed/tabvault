{
  "manifest_version": 3,
  "name": "TabVault Local",
  "version": "0.1.2",
  "description": "Automatic local backups for your browser sessions.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TabVault Local",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "commands": {
    "save-session": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Save the current browser session"
    }
  }
}
